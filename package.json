{
  "name": "tuk-tuk-climb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node scripts/crash-test.js && node scripts/sim-test.js",
    "test:race": "node scripts/race-test.js",
    "test:net": "node scripts/net-test.js",
    "relay": "node server/dev-relay.js",
