  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@fontsource/baloo-2": "^5.3.0",
    "planck": "^1.5.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "vite": "^8.3.3",
    "ws": "^8.18.3"
  }
}
